MainApp/Program.vb
Copy' ═══════════════════════════════════════════════════════════════
' Program.vb — 진입점
' ═══════════════════════════════════════════════════════════════
' 플러그인 조립 순서:
' ① 브릿지 시작 (서버 연결)
' ② 플러그인 등록 (지표, 전략, 주문)
' ③ MainShell 실행
' ═══════════════════════════════════════════════════════════════

Imports System.Windows.Forms

Module Program

    Sub Main()
        Application.EnableVisualStyles()
        Application.SetCompatibleTextRenderingDefault(False)

        ' ── 로거 초기화 ──
        AppLogger.I.Info("═══════════════════════════════════════")
        AppLogger.I.Info("  프로세스 시작")
        AppLogger.I.Info("═══════════════════════════════════════")

        ' ── 1) 브릿지 시작 (32‑bit 서버 연결) ──
        AppLogger.I.Info("브릿지 시작 중...", "Boot")

        Dim kiwoomBridge As New KiwoomBridge()
        kiwoomBridge.Start()
        AppLogger.I.Info("KiwoomBridge 시작됨", "Boot")

        Dim cybosBridge As New CybosBridge()
        cybosBridge.Start()
        AppLogger.I.Info("CybosBridge 시작됨", "Boot")

        ' ── 2) 지표 플러그인 ──
        ' (★3 단계에서 추가)
        ' Dim ma As New MA_Indicator()
        ' Dim rsi As New RSI_Indicator()
        ' Dim macd As New MACD_Indicator()
        AppLogger.I.Info("지표 플러그인: 미구현 (★3 단계)", "Boot")

        ' ── 3) 전략 플러그인 ──
        ' (★4 단계에서 추가)
        ' Dim strategy As New GoldenCross_Strategy()
        AppLogger.I.Info("전략 플러그인: 미구현 (★4 단계)", "Boot")

        ' ── 4) 주문 플러그인 ──
        ' (★5 단계에서 추가)
        ' Dim orders As New OrderPlugin()
        AppLogger.I.Info("주문 플러그인: 미구현 (★5 단계)", "Boot")

        ' ── 5) 메인 셸 실행 ──
        AppLogger.I.Info("MainShell 실행...", "Boot")
        Dim shell As New MainShell()
        Application.Run(shell)

    End Sub

End Module
