<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <MyType>Empty</MyType>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <StartupObject>KiwoomServer.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="3.119.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.vbproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AxInterop.KHOpenAPILib">
      <HintPath Condition="Exists('..\lib\x86\kiwoom\AxInterop.KHOpenAPILib.dll')">..\lib\x86\kiwoom\AxInterop.KHOpenAPILib.dll</HintPath>
      <HintPath Condition="!Exists('..\lib\x86\kiwoom\AxInterop.KHOpenAPILib.dll')">C:\Users\haoru\Desktop\2025\Template\lib\AxInterop.KHOpenAPILib.dll</HintPath>
    </Reference>
    <Reference Include="Interop.KHOpenAPILib">
      <HintPath Condition="Exists('..\lib\x86\kiwoom\Interop.KHOpenAPILib.dll')">..\lib\x86\kiwoom\Interop.KHOpenAPILib.dll</HintPath>
      <HintPath Condition="!Exists('..\lib\x86\kiwoom\Interop.KHOpenAPILib.dll')">C:\Users\haoru\Desktop\2025\Template\lib\Interop.KHOpenAPILib.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
